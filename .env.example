# Copy to .env and fill in. This file holds the client-facing secret: anyone
# who has it can use your relay, so it is mode 0600 and never commit it.
#
# Everything here is plain shell syntax: do not quote values.

# The public hostname clients are configured with. It must be the exact hostname
# the bridge capability is derived from, so use the ASCII A-label form.
TPROXY_HOSTNAME=proxy.example.com

# 16 random bytes, hex encoded: openssl rand -hex 16
# The only thing protecting the relay.
TPROXY_SECRET=

# Optional base path, e.g. "phcf2vfe7zgbrslg". Moves the bridge off the site
# root. The client then takes "hostname/basepath" as the proxy server and the
# secret in the marked 0x70 base64url form, which the entrypoint derives.
TPROXY_BASE_PATH=

# https | https-lanes | websocket | websocket-lanes
# "https" is the conservative baseline. "websocket" removes HTTP stop-and-wait
# and is a good fit when a media-heavy client sits behind a lossy link.
TPROXY_CARRIER_MODE=https

# <local>:<public> for MTProxy's middle-end. Required behind any NAT, including
# a container bridge: MTProxy derives its middle-end AES keys from its own
# source address, so without this it announces an address Telegram never sees
# arrivals from and every stream stalls silently. Leave empty only on a host
# with a directly routable public address.
TPROXY_NAT_INFO=

MTPROXY_WORKERS=1
MTPROXY_MAX_CONNECTIONS=4096

# Cloudflare Tunnel token: Zero Trust -> Networks -> Tunnels -> your tunnel.
# Only used by the "tunnel" profile.
TUNNEL_TOKEN=
CLOUDFLARED_VERSION=2026.9.3

# Host port for reaching Caddy locally, e.g. to check the site before adding the
# tunnel hostname. Bound to 127.0.0.1 only.
LOCAL_HTTP_PORT=8080

# ACME account email, only needed for a direct deployment where Caddy obtains
# its own certificate. Empty is correct behind a tunnel.
ACME_EMAIL=
